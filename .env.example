# GreenPulse Application Environment Variables

# Database Configuration (MySQL / H2)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=greenpulsedb
DB_USER=greenpulse
DB_PASSWORD=greenpulsepassword

# JWT Security Secret & Expiration (24 Hours)
JWT_SECRET=GreenPulseSuperSecretJwtKeyForDevelopmentModeOnlyMin256BitsLong!
JWT_EXPIRATION_MS=86400000

# Server Port Configuration
PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api

# Disclaimer & Mode Notice
APP_ENV=development
SIMULATED_GOVERNMENT_ADAPTER=true
